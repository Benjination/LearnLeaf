<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/assignmentInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Assignment"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/subjectInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Subject"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/projectInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Project"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/descriptionInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:lines="3"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/startDateInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Start Date (MM/dd/yyyy)"
            android:inputType="date"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/dueDateInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Due Date (MM/dd/yyyy)"
            android:inputType="date"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Priority"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/prioritySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Status"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/statusSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>
</ScrollView>
