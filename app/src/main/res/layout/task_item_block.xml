<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/taskCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/material_dynamic_primary60"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/taskNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Project1" /> <!-- Example task name -->

        <TextView
            android:id="@+id/taskDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="xxx" /> <!-- Example task description -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/taskPriorityTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="Low" /> <!-- Example task priority -->

            <TextView
                android:id="@+id/taskStatusTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="Not Started" /> <!-- Example task status -->
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/taskProjectTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="Project" /> <!-- Example task project -->

            <TextView
                android:id="@+id/taskSubjectTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:text="SW Testing" /> <!-- Example task subject -->
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/startDateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize = "16sp"/>

            <TextView
                android:id="@+id/dueDateTextView"
                android:layout_width = "0dp"
                android:layout_height = "wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "wrap_content">

            <ImageButton
                android:id="@+id/editButton"
                android:contentDescription="TODO"
                app:tint="?attr/colorControlNormal"
                app:srcCompat="@drawable/edit"
                android:layout_width="48dp"
                android:layout_height="48dp"/>

            <Space
                android:id="@+id/space"
                android:layout_width = "200dp"
                android:layout_height = "wrap_content"/>

            <ImageButton
                android:id="@+id/deleteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="TODO"
                app:tint="?attr/colorControlNormal"
                app:srcCompat="@drawable/tinytrash"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>